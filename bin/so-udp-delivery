#!/usr/bin/env bash
#
# so-udp-delivery - configure, install and validate the single-packet UDP
#                   delivery detections on a Security Onion grid.
#
# Runs on the SO manager. Every subcommand that writes anything is a dry run
# unless --confirm is passed, and every write is backed up first.
#
# Usage:  so-udp-delivery <command> [options]
# Run    so-udp-delivery help   for the command list.

set -euo pipefail

VERSION="1.0.0"
MARKER_BEGIN="# BEGIN so-udp-delivery-detections"
MARKER_END="# END so-udp-delivery-detections"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SURICATA_RULES="${REPO_ROOT}/rules/suricata/udp-delivery.rules"
SIGMA_DIR="${REPO_ROOT}/rules/sigma"
BACKUP_DIR="${REPO_ROOT}/.backups"

CONFIRM=0
VERBOSE=0

# Candidate locations, most-current first. Security Onion has moved these
# between releases, so we probe rather than assume. `check` reports which
# exist; nothing is written to a path that was not discovered.
SURICATA_RULE_CANDIDATES=(
    "/opt/so/saltstack/local/salt/idstools/rules/local.rules"
    "/opt/so/saltstack/local/salt/idstools/local.rules"
    "/opt/so/rules/nids/local.rules"
    "/nsm/rules/local.rules"
)
SIGMA_DIR_CANDIDATES=(
    "/opt/so/saltstack/local/salt/elastalert/rules"
    "/opt/so/rules/elastalert/custom"
    "/opt/so/conf/soc/sigma"
)
SURICATA_YAML_CANDIDATES=(
    "/opt/so/conf/suricata/suricata.yaml"
    "/etc/suricata/suricata.yaml"
)
PILLAR_CANDIDATES=(
    "/opt/so/saltstack/local/pillar/global.sls"
    "/opt/so/saltstack/local/pillar/minions"
)

# --- output helpers --------------------------------------------------------

if [[ -t 1 ]]; then
    C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'
    C_BLU=$'\033[34m'; C_DIM=$'\033[2m';  C_RST=$'\033[0m'
else
    C_RED=""; C_GRN=""; C_YEL=""; C_BLU=""; C_DIM=""; C_RST=""
fi

ok()    { printf '%s  ok  %s %s\n' "$C_GRN" "$C_RST" "$*"; }
warn()  { printf '%s warn %s %s\n' "$C_YEL" "$C_RST" "$*"; }
fail()  { printf '%s fail %s %s\n' "$C_RED" "$C_RST" "$*"; }
info()  { printf '%s info %s %s\n' "$C_BLU" "$C_RST" "$*"; }
dim()   { printf '%s      %s%s\n' "$C_DIM" "$*" "$C_RST"; }
head1() { printf '\n%s== %s ==%s\n' "$C_BLU" "$*" "$C_RST"; }
die()   { fail "$*"; exit 1; }

dryrun_notice() {
    if [[ $CONFIRM -eq 0 ]]; then
        printf '\n%s DRY RUN - nothing was changed. Re-run with --confirm to apply.%s\n' \
            "$C_YEL" "$C_RST"
    fi
}

# --- discovery -------------------------------------------------------------

discover_first_existing() {
    # Print the first path in the argument list that exists.
    local p
    for p in "$@"; do
        [[ -e "$p" ]] && { printf '%s\n' "$p"; return 0; }
    done
    return 1
}

discover_suricata_rules_path() {
    # An existing local.rules file wins. Otherwise the first candidate whose
    # PARENT directory exists - that is where SO expects local rules to go.
    local p
    for p in "${SURICATA_RULE_CANDIDATES[@]}"; do
        [[ -f "$p" ]] && { printf '%s\n' "$p"; return 0; }
    done
    for p in "${SURICATA_RULE_CANDIDATES[@]}"; do
        [[ -d "$(dirname "$p")" ]] && { printf '%s\n' "$p"; return 0; }
    done
    return 1
}

discover_sigma_dir() {
    discover_first_existing "${SIGMA_DIR_CANDIDATES[@]}"
}

discover_suricata_yaml() {
    discover_first_existing "${SURICATA_YAML_CANDIDATES[@]}"
}

rules_path_is_loaded() {
    # True if Suricata's rule-files list mentions this file. Returns 2 when
    # the question cannot be answered (no suricata.yaml, no rule-files block),
    # which the caller treats as "unknown", not as "no".
    local path="$1" syaml rulefiles
    syaml="$(discover_suricata_yaml)" || return 2
    rulefiles="$(awk '
        /^[[:space:]]*rule-files:/ { flag=1; next }
        flag && /^[[:space:]]*-[[:space:]]*/ { sub(/^[[:space:]]*-[[:space:]]*/,""); print; next }
        flag { exit }
    ' "$syaml" 2>/dev/null)" || return 2
    [[ -n "$rulefiles" ]] || return 2
    printf '%s\n' "$rulefiles" | grep -qF "$(basename "$path")"
}

so_version() {
    if [[ -r /etc/soversion ]]; then
        cat /etc/soversion
    elif command -v so-status >/dev/null 2>&1; then
        so-status --version 2>/dev/null | head -1
    else
        printf 'unknown\n'
    fi
}

require_root() {
    [[ "$(id -u)" -eq 0 ]] || die "must run as root (try: sudo $0 $*)"
}

# --- check -----------------------------------------------------------------

cmd_check() {
    head1 "Security Onion environment"

    local ver; ver="$(so_version)"
    if [[ "$ver" == "unknown" ]]; then
        warn "Security Onion version could not be determined"
        dim "this may not be an SO manager - most commands will not work here"
    else
        ok "Security Onion $ver"
    fi

    command -v salt-call >/dev/null 2>&1 \
        && ok "salt-call present" \
        || warn "salt-call not found - deploy will not be able to apply states"

    command -v suricata >/dev/null 2>&1 \
        && ok "suricata binary present ($(suricata -V 2>/dev/null | head -1))" \
        || warn "suricata binary not in PATH - 'test' will use the docker container if available"

    head1 "Which install route applies"

    # Determined here, before anything is called "ok". A discovered path is a
    # candidate, not a verdict - the verdict is whether Suricata loads it.
    local rules_path sigma_dir file_route="unknown"
    if rules_path="$(discover_suricata_rules_path)"; then
        info "candidate local rules path: $rules_path"
        [[ -f "$rules_path" ]] \
            && grep -q "$MARKER_BEGIN" "$rules_path" 2>/dev/null \
            && info "this repo's block is already installed there"
    else
        warn "no Suricata local-rules location found"
        dim "probed: ${SURICATA_RULE_CANDIDATES[*]}"
    fi

    local syaml_early rulefiles rf
    if syaml_early="$(discover_suricata_yaml)"; then
        local defrulepath
        defrulepath="$(grep -E '^\s*default-rule-path:' "$syaml_early" 2>/dev/null | head -1 | sed 's/^\s*//')" || true
        [[ -n "$defrulepath" ]] && dim "$defrulepath"

        rulefiles="$(awk '
            /^[[:space:]]*rule-files:/ { flag=1; next }
            flag && /^[[:space:]]*-[[:space:]]*/ { sub(/^[[:space:]]*-[[:space:]]*/,""); print; next }
            flag { exit }
        ' "$syaml_early" 2>/dev/null)" || true

        if [[ -n "$rulefiles" ]]; then
            info "suricata loads these rule files:"
            while IFS= read -r rf; do [[ -n "$rf" ]] && dim "  $rf"; done <<< "$rulefiles"

            if [[ -n "${rules_path:-}" ]] \
                && printf '%s\n' "$rulefiles" | grep -qF "$(basename "$rules_path")"; then
                file_route="ok"
                ok "FILE ROUTE: $(basename "$rules_path") is loaded - install will work"
            else
                file_route="no"
                warn "FILE ROUTE UNAVAILABLE: $(basename "$rules_path") is not loaded"
                dim "writing rules there would have no effect and no error, so"
                dim "'install' refuses it. This is normal on Security Onion 2.4+,"
                dim "where SOC generates the rules file from the so-detection index."
                ok "SOC ROUTE: use 'export-soc --format text' and SOC -> Detections"
            fi
        else
            warn "no rule-files: block found in $syaml_early"
            dim "cannot confirm whether a local rules file would be loaded."
        fi
    fi

    if sigma_dir="$(discover_sigma_dir)"; then
        ok "Sigma custom rules directory: $sigma_dir"
    else
        warn "no Sigma custom-rules directory found"
        dim "probed: ${SIGMA_DIR_CANDIDATES[*]}"
        dim "the SOC Detections UI is the alternative - see 'so-udp-delivery export-soc'"
    fi

    head1 "Configuration that affects whether these rules can fire"

    local syaml
    if syaml="$(discover_suricata_yaml)"; then
        ok "suricata.yaml: $syaml"

        # HOME_NET must contain the monitored WAN address or every rule in
        # this set matches nothing at all.
        local homenet
        homenet="$(grep -E '^\s*HOME_NET:' "$syaml" 2>/dev/null | head -1 | sed 's/^\s*//')" || true
        if [[ -n "$homenet" ]]; then
            # A HOME_NET of nothing but RFC1918 space is the silent-failure
            # case: single-packet UDP delivery is addressed to the public WAN
            # address, so with no routable address in HOME_NET every rule here
            # matches nothing and reports no error.
            info "$homenet"
            if printf '%s' "$homenet" | grep -qE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/32'; then
                ok "contains a /32 - looks like the monitored WAN address is listed"
            else
                warn "no /32 host address in HOME_NET"
                dim "these rules are '-> \$HOME_NET' and single-packet UDP delivery is"
                dim "addressed to the public WAN IP. If that address is not inside"
                dim "HOME_NET, nothing fires and nothing errors."
            fi
        else
            warn "HOME_NET not found in $syaml (it may be set via pillar)"
        fi

        # Bad-checksum packets are skipped by default. Some of the traffic
        # this repo targets carries malformed checksums deliberately.
        local cksum
        cksum="$(grep -E '^\s*checksum-validation:' "$syaml" 2>/dev/null | head -1 | sed 's/^\s*//')" || true
        if [[ -n "$cksum" ]]; then
            if printf '%s' "$cksum" | grep -qiE ':\s*(none|false|no)\s*$'; then
                ok "$cksum"
            else
                warn "$cksum"
                dim "packets with bad checksums may be skipped before rule evaluation."
                dim "crafted delivery traffic sometimes has deliberately malformed checksums."
                dim "see 'so-udp-delivery configure' for the setting to change."
            fi
        else
            warn "checksum-validation not found in $syaml"
        fi

        # Without these, the alert reaches Elastic with no payload and no
        # metadata - which defeats the entire point of the exercise.
        #
        # Suricata accepts yes/true/1 interchangeably and Security Onion
        # writes booleans as true/false, so match all spellings. Matching only
        # "yes" produces a false NEGATIVE on a grid that is correctly
        # configured - which is exactly what this check did on SO 3.3.0.
        check_eve_opt() {
            local key="$1" level="$2" ; shift 2
            if grep -qiE "^[[:space:]]*${key}:[[:space:]]*(yes|true|1)[[:space:]]*$" "$syaml" 2>/dev/null; then
                ok "eve alert output: ${key} enabled"
                return 0
            fi
            if grep -qiE "^[[:space:]]*${key}:" "$syaml" 2>/dev/null; then
                "$level" "eve alert output: ${key} is present but not enabled"
            else
                "$level" "eve alert output: ${key} not found in $syaml"
                dim "it may be set elsewhere - trust the empirical check below over this one."
            fi
            local line
            for line in "$@"; do dim "$line"; done
            return 1
        }

        # payload-printable is the one that matters. Security Onion maps eve's
        # payload_printable to network.data.decoded, which is the field every
        # hunt in this repo reads. Plain `payload` adds the raw base64 copy -
        # useful for byte-exact work on binary vectors like Easydisc, but not
        # required, and retained pcap is the better source for that anyway.
        check_eve_opt payload-printable fail \
            "this is what populates network.data.decoded - the field the hunts read." || true
        check_eve_opt payload warn \
            "optional. Adds the raw base64 copy alongside the printable one." \
            "worth enabling for byte-exact work on binary vectors; not a blocker." || true
        check_eve_opt metadata warn \
            "without it, delivery_class / delivery_kit / vector never become" \
            "queryable fields, and the classification scheme is reduced to" \
            "matching on rule names." || true
    else
        warn "suricata.yaml not found"
        dim "probed: ${SURICATA_YAML_CANDIDATES[*]}"
    fi

    # Config parsing is fragile - key names, value spellings and file layout
    # all move between releases. What actually reached Elasticsearch does not
    # lie, so this section overrides the one above wherever they disagree.
    head1 "Empirical check (authoritative - overrides the config parse above)"

    if command -v so-elasticsearch-query >/dev/null 2>&1; then
        local q_payload count_payload
        q_payload='{"query":{"bool":{"filter":[{"exists":{"field":"network.data.decoded"}},{"range":{"@timestamp":{"gte":"now-24h"}}}]}}}'
        count_payload="$(so-elasticsearch-query "*:logs-suricata.alerts-so/_count" -d "$q_payload" 2>/dev/null \
            | tr ',' '\n' | grep -oE '"count":[0-9]+' | head -1 | cut -d: -f2)" || true

        if [[ -n "${count_payload:-}" && "$count_payload" -gt 0 ]]; then
            ok "$count_payload alerts in the last 24h carry network.data.decoded"
            dim "payload logging is on, whatever the config parse above said."
        elif [[ -n "${count_payload:-}" ]]; then
            fail "no alerts in the last 24h carry a decoded payload"
            dim "for single-packet UDP the alert IS the capture - fix this first."
        else
            warn "could not read a payload count from Elasticsearch"
        fi

        local q_meta count_meta
        q_meta='{"query":{"bool":{"filter":[{"exists":{"field":"rule.metadata.signature_severity"}},{"range":{"@timestamp":{"gte":"now-24h"}}}]}}}'
        count_meta="$(so-elasticsearch-query "*:logs-suricata.alerts-so/_count" -d "$q_meta" 2>/dev/null \
            | tr ',' '\n' | grep -oE '"count":[0-9]+' | head -1 | cut -d: -f2)" || true

        if [[ -n "${count_meta:-}" && "$count_meta" -gt 0 ]]; then
            ok "$count_meta alerts in the last 24h carry rule.metadata.*"
            dim "rule metadata survives ingest. After install, confirm the CUSTOM"
            dim "keys survive too - see 'Metadata' in docs/classification.md."
        else
            warn "no rule.metadata.* seen in the last 24h"
        fi
    else
        warn "so-elasticsearch-query not available - cannot verify empirically"
        dim "check by hand in Hunt, over the last 24 hours:"
        dim '  _exists_:network.data.decoded'
        dim "if that returns results, payload logging is on regardless of what"
        dim "the config parse above reported."
    fi

    head1 "Repo contents"
    if [[ -f "$SURICATA_RULES" ]]; then
        ok "$(grep -c '^alert' "$SURICATA_RULES") Suricata rules in $(basename "$SURICATA_RULES")"
    else
        fail "missing $SURICATA_RULES"
    fi
    local n_sigma
    n_sigma="$(find "$SIGMA_DIR" -name '*.yml' 2>/dev/null | wc -l)"
    ok "$n_sigma Sigma rules in rules/sigma/"

    head1 "Next steps"

    info "check is read-only - nothing above changed anything."
    dim ""
    dim "1. sudo so-udp-delivery test"
    dim "   validates all 13 rules against a live Suricata parser. Do this"
    dim "   first whichever route you take."
    case "$file_route" in
        ok)
            dim "2. sudo so-udp-delivery install --confirm"
            dim "3. sudo so-udp-delivery deploy --confirm"
            dim "4. sudo so-udp-delivery verify"
            ;;
        no)
            dim ""
            dim "2. so-udp-delivery export-soc --format text"
            dim "   then paste each rule into SOC -> Detections -> New Detection,"
            dim "   language suricata, ruleset __custom__."
            dim ""
            dim "   Start with three rather than all thirteen:"
            dim "     1000010  kit fingerprint - lowest false-positive risk"
            dim "     1000001  generic wget    - highest expected hit rate"
            dim "     1000020  Easydisc        - capture-derived offsets, needs a live test"
            dim ""
            dim "3. after a day: rule.name:LOCAL* | groupby rule.name"
            dim "   then add the rest."
            dim ""
            warn "'install' will refuse on this grid - that is correct, not a fault."
            ;;
        *)
            dim "2. route undetermined - check the rule-files output above before"
            dim "   installing, or use the SOC route, which always works."
            ;;
    esac
}

# --- test ------------------------------------------------------------------

cmd_test() {
    head1 "Suricata rule syntax"

    [[ -f "$SURICATA_RULES" ]] || die "missing $SURICATA_RULES"

    local syaml pcap="${1:-}"
    syaml="$(discover_suricata_yaml || true)"

    # 1. Security Onion ships its own rule tester:
    #
    #      so-suricata-testrule <CustomRule> <TargetPCAP>
    #
    #    It appends the custom rules to a COPY of all-rulesets.rules (the live
    #    ruleset is not touched) and runs Suricata over the pcap in a
    #    purpose-built container with the right mounts. It knows where the
    #    binary lives and which paths are visible inside, so prefer it.
    #
    #    It requires a pcap. For a syntax-only check we hand it an empty one:
    #    Suricata still loads and parses every rule, then processes zero
    #    packets, so rule errors surface exactly the same way.
    if command -v so-suricata-testrule >/dev/null 2>&1; then
        local target="$pcap" tmpdir=""
        if [[ -z "$target" ]]; then
            tmpdir="$(mktemp -d)"
            target="${tmpdir}/empty.pcap"
            # 24-byte libpcap file header, no packets: LE magic, v2.4,
            # snaplen 65535, linktype 1 (Ethernet).
            printf '\xd4\xc3\xb2\xa1\x02\x00\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\xff\xff\x00\x00\x01\x00\x00\x00' > "$target"
            info "syntax-only check against an empty pcap"
            dim "to see which rules actually FIRE, pass a real capture:"
            dim "  so-udp-delivery test /path/to/delivery.pcap"
        else
            [[ -f "$target" ]] || die "no such pcap: $target"
            info "running the rules against $target"
        fi

        info "so-suricata-testrule $SURICATA_RULES $target"
        local rc_native=0
        so-suricata-testrule "$SURICATA_RULES" "$target" || rc_native=$?
        [[ -n "$tmpdir" ]] && rm -rf "$tmpdir"

        if [[ $rc_native -eq 0 ]]; then
            ok "suricata loaded all-rulesets.rules with our rules appended"
            dim "in the output above, confirm:"
            dim "  - a 'rules successfully loaded' line with 0 failed"
            dim "  - no error lines naming SIDs in the 10000xx range"
            [[ -n "$pcap" ]] && dim "  - which LOCAL IOT-DELIVERY SIDs fired on this capture"
            cmd_test_sigma
            return 0
        fi
        warn "so-suricata-testrule returned $rc_native - see its output above"
        dim "falling back to a direct container test..."
    fi

    # 2. Direct test inside the container. Two things make the naive
    #    'docker exec so-suricata suricata' fail on a real grid: the binary is
    #    not necessarily called 'suricata' on $PATH in there, and the rules
    #    file lives on the host outside anything the container mounts - so it
    #    has to be copied in rather than referenced by host path.
    command -v docker >/dev/null 2>&1 \
        || die "no so-suricata-testrule and no docker - cannot validate syntax"
    docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^so-suricata$' \
        || die "the so-suricata container is not running - cannot validate syntax"

    local bin="" cand
    for cand in suricata /usr/bin/suricata /usr/sbin/suricata /usr/local/bin/suricata; do
        if docker exec so-suricata sh -c "command -v '$cand' >/dev/null 2>&1" 2>/dev/null; then
            bin="$cand"; break
        fi
    done
    if [[ -z "$bin" ]]; then
        fail "could not find a suricata binary inside the so-suricata container"
        dim "probed: suricata /usr/bin/suricata /usr/sbin/suricata /usr/local/bin/suricata"
        dim "find it with:  docker exec so-suricata sh -c 'ls -l /usr/bin | grep -i suri'"
        die "cannot validate syntax"
    fi
    info "suricata binary inside container: $bin"

    local inpath="/tmp/udp-delivery-test.rules"
    docker cp "$SURICATA_RULES" "so-suricata:${inpath}" >/dev/null 2>&1 \
        || die "docker cp of the rules file into the container failed"
    info "rules copied into the container at $inpath"

    local rc=0
    if [[ -n "$syaml" ]]; then
        info "running: $bin -T -c $syaml -S $inpath"
        docker exec so-suricata "$bin" -T -c "$syaml" -S "$inpath" || rc=$?
        if [[ $rc -ne 0 ]]; then
            warn "test with -c $syaml failed; retrying without an explicit config"
            rc=0
            docker exec so-suricata "$bin" -T -S "$inpath" || rc=$?
        fi
    else
        info "running: $bin -T -S $inpath"
        docker exec so-suricata "$bin" -T -S "$inpath" || rc=$?
    fi

    docker exec so-suricata rm -f "$inpath" >/dev/null 2>&1 || true

    if [[ $rc -eq 0 ]]; then
        ok "rules parse cleanly"
    else
        die "rule validation failed - do not install until this passes"
    fi

    cmd_test_sigma
}

cmd_test_sigma() {
    head1 "Sigma rule syntax"
    local f sigma_rc=0
    for f in "$SIGMA_DIR"/*.yml; do
        [[ -e "$f" ]] || continue
        if command -v python3 >/dev/null 2>&1; then
            if python3 -c "import yaml,sys; yaml.safe_load(open(sys.argv[1]))" "$f" 2>/dev/null; then
                ok "$(basename "$f")"
            else
                fail "$(basename "$f") - YAML does not parse"; sigma_rc=1
            fi
        else
            warn "python3 not available, skipping YAML validation"
            break
        fi
    done
    [[ $sigma_rc -eq 0 ]] || die "fix the Sigma rules before installing"
}

# --- install ---------------------------------------------------------------

backup_file() {
    local src="$1"
    [[ -f "$src" ]] || return 0
    mkdir -p "$BACKUP_DIR"
    local dest="${BACKUP_DIR}/$(basename "$src").$(date +%Y%m%dT%H%M%SZ).bak"
    if [[ $CONFIRM -eq 1 ]]; then
        cp -p "$src" "$dest"
        info "backed up $src -> $dest"
    else
        dim "would back up $src -> $dest"
    fi
}

strip_marker_block() {
    # Remove any previously installed block from stdin.
    sed "/^${MARKER_BEGIN}/,/^${MARKER_END}/d"
}

cmd_install() {
    require_root install

    local rules_path="${OPT_RULES_PATH:-}"
    if [[ -z "$rules_path" ]]; then
        rules_path="$(discover_suricata_rules_path)" \
            || die "no Suricata local-rules location found; pass --rules-path"
    fi

    head1 "Installing Suricata rules"
    info "target: $rules_path"

    [[ -f "$SURICATA_RULES" ]] || die "missing $SURICATA_RULES"

    # Refuse to write somewhere Suricata will not read from. A silent no-op
    # install is worse than a failed one: the rules look deployed, nothing
    # fires, and the natural conclusion is that the rules are wrong.
    local loaded_rc=0
    rules_path_is_loaded "$rules_path" || loaded_rc=$?
    case $loaded_rc in
        0) ok "$(basename "$rules_path") is in Suricata's rule-files - safe to write" ;;
        2) warn "could not determine whether Suricata loads $(basename "$rules_path")"
           dim "proceeding, but confirm with 'verify' after deploy." ;;
        *) fail "$rules_path is NOT in Suricata's rule-files list"
           dim ""
           dim "Writing there would have no effect. On Security Onion 2.4+ SOC"
           dim "generates the rules file from the so-detection index, so a"
           dim "hand-written local.rules can be ignored entirely."
           dim ""
           dim "Use the SOC Detections route instead:"
           dim "  ./bin/so-udp-delivery export-soc > detections.ndjson"
           dim "  or paste rules into SOC -> Detections -> New Detection"
           dim ""
           dim "To override anyway: --force (not recommended)"
           [[ "${OPT_FORCE:-0}" -eq 1 ]] || die "refusing to install to an unloaded path"
           warn "--force given, continuing against an unloaded path" ;;
    esac

    backup_file "$rules_path"

    local tmp; tmp="$(mktemp)"
    if [[ -f "$rules_path" ]]; then
        strip_marker_block < "$rules_path" > "$tmp"
    else
        : > "$tmp"
    fi
    {
        printf '%s v%s (installed %s)\n' "$MARKER_BEGIN" "$VERSION" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf '# Managed block. Edits here are overwritten on reinstall.\n'
        printf '# Source: https://github.com/graphworlok/so-udp-delivery-detections\n'
        cat "$SURICATA_RULES"
        printf '%s\n' "$MARKER_END"
    } >> "$tmp"

    local n; n="$(grep -c '^alert' "$SURICATA_RULES")"
    if [[ $CONFIRM -eq 1 ]]; then
        cat "$tmp" > "$rules_path"
        ok "wrote $n rules to $rules_path"
    else
        dim "would write $n rules to $rules_path"
        dim "SIDs: $(grep -oE 'sid:[0-9]+' "$SURICATA_RULES" | cut -d: -f2 | tr '\n' ' ')"
    fi
    rm -f "$tmp"

    head1 "Installing Sigma rules"
    local sigma_dir
    if sigma_dir="$(discover_sigma_dir)"; then
        local f
        for f in "$SIGMA_DIR"/*.yml; do
            [[ -e "$f" ]] || continue
            local dest="${sigma_dir}/$(basename "$f")"
            backup_file "$dest"
            if [[ $CONFIRM -eq 1 ]]; then
                cp "$f" "$dest"
                ok "installed $(basename "$f")"
            else
                dim "would install $(basename "$f") -> $dest"
            fi
        done
    else
        warn "no Sigma directory found - skipping"
        dim "use 'so-udp-delivery export-soc' and import via the SOC Detections UI instead"
    fi

    dryrun_notice
    [[ $CONFIRM -eq 1 ]] && info "now run: so-udp-delivery deploy --confirm"
    return 0
}

# --- remove ----------------------------------------------------------------

cmd_remove() {
    require_root remove

    local rules_path="${OPT_RULES_PATH:-}"
    [[ -n "$rules_path" ]] || rules_path="$(discover_suricata_rules_path)" \
        || die "no Suricata local-rules location found"

    head1 "Removing managed block"
    if [[ ! -f "$rules_path" ]]; then
        warn "$rules_path does not exist - nothing to remove"
        return 0
    fi
    if ! grep -q "$MARKER_BEGIN" "$rules_path"; then
        warn "no managed block in $rules_path - nothing to remove"
        return 0
    fi

    backup_file "$rules_path"
    if [[ $CONFIRM -eq 1 ]]; then
        local tmp; tmp="$(mktemp)"
        strip_marker_block < "$rules_path" > "$tmp"
        cat "$tmp" > "$rules_path"
        rm -f "$tmp"
        ok "removed managed block from $rules_path"
    else
        dim "would remove the managed block from $rules_path"
    fi

    local sigma_dir f
    if sigma_dir="$(discover_sigma_dir)"; then
        for f in "$SIGMA_DIR"/*.yml; do
            [[ -e "$f" ]] || continue
            local dest="${sigma_dir}/$(basename "$f")"
            [[ -f "$dest" ]] || continue
            if [[ $CONFIRM -eq 1 ]]; then
                rm -f "$dest"; ok "removed $(basename "$f")"
            else
                dim "would remove $dest"
            fi
        done
    fi

    dryrun_notice
    [[ $CONFIRM -eq 1 ]] && info "now run: so-udp-delivery deploy --confirm"
    return 0
}

# --- deploy ----------------------------------------------------------------

cmd_deploy() {
    require_root deploy

    head1 "Applying configuration"

    if [[ $CONFIRM -eq 0 ]]; then
        dim "would run: salt-call state.apply idstools"
        dim "would run: salt-call state.apply suricata"
        dim "would run: so-suricata-restart"
        dim "would run: so-elastalert-restart  (if Sigma rules were installed)"
        dryrun_notice
        return 0
    fi

    command -v salt-call >/dev/null 2>&1 || die "salt-call not found"

    info "salt-call state.apply idstools"
    salt-call state.apply idstools || warn "idstools state returned non-zero"

    info "salt-call state.apply suricata"
    salt-call state.apply suricata || warn "suricata state returned non-zero"

    if command -v so-suricata-restart >/dev/null 2>&1; then
        info "so-suricata-restart"
        so-suricata-restart || warn "suricata restart returned non-zero"
    fi

    if command -v so-elastalert-restart >/dev/null 2>&1; then
        info "so-elastalert-restart"
        so-elastalert-restart || warn "elastalert restart returned non-zero"
    fi

    ok "deploy complete"
    info "confirm the rules loaded: so-udp-delivery verify"
}

# --- configure -------------------------------------------------------------

cmd_configure() {
    head1 "Grid settings these detections depend on"

    cat <<'PILLAREOF'
On Security Onion 2.4 and later, set these through:

    SOC -> Administration -> Configuration -> suricata

That writes the pillar for you with the correct schema for your release.
Hand-editing /opt/so/saltstack/local/pillar/ works too, but the pillar layout
has changed between releases and a wrong guess fails quietly.

--- stream.checksum-validation ---------------------------------------------

Suricata skips rule evaluation on packets with bad checksums. Some crafted
delivery traffic carries deliberately malformed checksums, so the default
silently drops exactly the packets these rules target.

    current:  checksum-validation: true
    set to:   checksum-validation: false

This is a BOOLEAN. "none" is not a valid value here - it belongs to
af-packet's checksum-checks (auto|yes|no), which is a different setting.

Note this is unrelated to the zero UDP checksum in the kit fingerprint (SID
1000010). A zero UDP checksum is legal in IPv4 and means "not computed", so
it is never treated as invalid.

--- eve-log alert output ----------------------------------------------------

    payload: true
    payload-printable: true
    packet: true
    metadata: true

payload  - for single-packet UDP the alert IS the capture. Without it you get
           a detection with no evidence.
metadata - carries delivery_class / delivery_kit / vector through to
           Elasticsearch, which is what the classification scheme pivots on.

Suricata accepts yes/true/1 interchangeably; Security Onion writes true/false.
DO NOT change these based on the config parse in 'check' alone - check the
empirical section, which counts what actually reached Elasticsearch. If
payload is already arriving, leave this alone.

--- HOME_NET ----------------------------------------------------------------

Every rule here is written '-> $HOME_NET'. Single-packet UDP delivery is
addressed to the public WAN IP, so that address must be inside HOME_NET. If it
is not, nothing fires and nothing errors.

    so-udp-delivery check     # prints the running value
PILLAREOF

    printf '\n'
    info "configure only prints - it does not edit anything."
    dim "these settings affect the whole grid, so they are applied deliberately."
}

# --- verify ----------------------------------------------------------------

cmd_verify() {
    head1 "Are the rules loaded?"

    local rules_path
    if rules_path="$(discover_suricata_rules_path)" && [[ -f "$rules_path" ]]; then
        if grep -q "$MARKER_BEGIN" "$rules_path"; then
            ok "managed block present in $rules_path"
        else
            fail "managed block NOT present in $rules_path"
        fi
    fi

    if [[ -r /opt/so/log/suricata/suricata.log ]]; then
        local loaded
        loaded="$(grep -oE '[0-9]+ rules successfully loaded' /opt/so/log/suricata/suricata.log 2>/dev/null | tail -1)" || true
        [[ -n "$loaded" ]] && info "suricata.log: $loaded"
        if grep -qiE 'error.*(1000[0-9]{3})' /opt/so/log/suricata/suricata.log 2>/dev/null; then
            fail "suricata.log mentions errors against SIDs in our block:"
            grep -iE 'error.*(1000[0-9]{3})' /opt/so/log/suricata/suricata.log | tail -5
        fi
    fi

    head1 "Have they fired?"

    if command -v so-elasticsearch-query >/dev/null 2>&1; then
        local q='{"size":0,"query":{"bool":{"filter":[{"prefix":{"rule.name":"LOCAL IOT-DELIVERY"}},{"range":{"@timestamp":{"gte":"now-7d"}}}]}},"aggs":{"by_rule":{"terms":{"field":"rule.name","size":25}}}}'
        so-elasticsearch-query "*:logs-suricata.alerts-so/_search" -d "$q" 2>/dev/null \
            || warn "elasticsearch query failed"
    else
        warn "so-elasticsearch-query not available"
        dim "run this in Hunt instead, over the last 7 days:"
        dim '  rule.name:LOCAL* | groupby rule.name'
        dim "and to confirm the metadata pivot survived ingest:"
        dim '  rule.metadata.delivery_class:single_packet_udp | groupby rule.metadata.vector'
    fi
}

# --- import-pcap -----------------------------------------------------------

cmd_import_pcap() {
    local pcap="${1:-}"
    [[ -n "$pcap" ]] || die "usage: so-udp-delivery import-pcap <file.pcap>"
    [[ -f "$pcap" ]] || die "no such file: $pcap"

    command -v so-import-pcap >/dev/null 2>&1 || die "so-import-pcap not found"

    head1 "Replaying $pcap through Suricata and Zeek"
    info "this is the positive control: a known-good captured datagram should"
    info "produce a LOCAL IOT-DELIVERY alert with the payload attached."

    if [[ $CONFIRM -eq 0 ]]; then
        dim "would run: so-import-pcap $pcap"
        dryrun_notice
        return 0
    fi

    so-import-pcap "$pcap"
    printf '\n'
    info "so-import-pcap prints a Hunt URL scoped to the import's timestamps."
    info "Open it and confirm the expected SID fired. Imported events keep the"
    info "pcap's original timestamps, so search that range, not 'now'."
}

# --- export-soc ------------------------------------------------------------

cmd_export_soc() {
    # Emit the rules as so-detection documents. This is the shape SOC stores
    # custom detections in - confirmed against a live grid - and on Security
    # Onion 2.4+ it is the ONLY route, because Suricata there loads a single
    # SOC-generated file built from the so-detection index.
    #
    #   --format ndjson  (default)  one so-detection document per line
    #   --format text               paste-friendly, one rule per block, for
    #                               SOC -> Detections -> New Detection
    local author="${SUDO_USER:-${USER:-unknown}}"
    local now; now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    if [[ "${OPT_FORMAT:-ndjson}" == "text" ]]; then
        printf '# Paste each rule into SOC -> Detections -> New Detection.\n'
        printf '# Language: suricata for the SIDs, sigma for the YAML blocks.\n'
        printf '# Leave the ruleset as __custom__.\n\n'
        local line sid msg
        while IFS= read -r line; do
            case "$line" in
                alert\ *) ;;
                *) continue ;;
            esac
            sid="$(printf '%s' "$line" | grep -oE '\bsid:[0-9]+' | cut -d: -f2)"
            msg="$(printf '%s' "$line" | sed -n 's/.*msg:"\([^"]*\)".*/\1/p')"
            printf '# ---- SID %s ----------------------------------------\n' "$sid"
            printf '# %s\n' "$msg"
            printf '%s\n\n' "$line"
        done < "$SURICATA_RULES"

        local f
        for f in "$SIGMA_DIR"/*.yml; do
            [[ -e "$f" ]] || continue
            printf '# ---- sigma: %s ----------------------------------\n' "$(basename "$f")"
            cat "$f"
            printf '\n'
        done
        return 0
    fi

    python3 - "$SURICATA_RULES" "$SIGMA_DIR" "$author" "$now" <<'PYEOF'
import json, os, re, sys

rules_file, sigma_dir, author, now = sys.argv[1:5]

def emit(doc):
    print(json.dumps(doc, separators=(",", ":")))

with open(rules_file, "r", encoding="utf-8") as fh:
    for line in fh:
        line = line.strip()
        if not line.startswith("alert "):
            continue
        sid = re.search(r"\bsid:(\d+)", line)
        msg = re.search(r'\bmsg:"([^"]+)"', line)
        if not (sid and msg):
            continue
        title = msg.group(1)
        # SOC derives category from the leading tokens of msg.
        category = " ".join(title.split()[:2])
        emit({
            "so_kind": "detection",
            "so_detection.publicId": sid.group(1),
            "so_detection.title": title,
            "so_detection.category": category,
            "so_detection.severity": "high" if "Critical" in line else "medium",
            "so_detection.author": author,
            "so_detection.description": "",
            "so_detection.content": line,
            "so_detection.isEnabled": True,
            "so_detection.isReporting": False,
            "so_detection.isCommunity": False,
            "so_detection.engine": "suricata",
            "so_detection.language": "suricata",
            "so_detection.ruleset": "__custom__",
            "so_detection.license": "BSD-3-Clause",
            "so_detection.createTime": now,
        })

for name in sorted(os.listdir(sigma_dir)):
    if not name.endswith((".yml", ".yaml")):
        continue
    path = os.path.join(sigma_dir, name)
    with open(path, "r", encoding="utf-8") as fh:
        content = fh.read()
    rid = re.search(r"^id:\s*(\S+)", content, re.M)
    title = re.search(r"^title:\s*(.+)$", content, re.M)
    level = re.search(r"^level:\s*(\S+)", content, re.M)
    if not (rid and title):
        sys.stderr.write("skipping %s: no id/title\n" % name)
        continue
    emit({
        "so_kind": "detection",
        "so_detection.publicId": rid.group(1),
        "so_detection.title": title.group(1).strip(),
        "so_detection.category": "network",
        "so_detection.severity": (level.group(1) if level else "medium"),
        "so_detection.author": author,
        "so_detection.description": "",
        "so_detection.content": content,
        "so_detection.isEnabled": True,
        "so_detection.isReporting": False,
        "so_detection.isCommunity": False,
        "so_detection.engine": "elastalert",
        "so_detection.language": "sigma",
        "so_detection.ruleset": "__custom__",
        "so_detection.license": "BSD-3-Clause",
        "so_detection.product": "zeek",
        "so_detection.createTime": now,
    })
PYEOF
}

# --- help ------------------------------------------------------------------

cmd_help() {
    cat <<HELPEOF
so-udp-delivery v${VERSION}

Configure, install and validate single-packet UDP delivery detections on a
Security Onion grid.

COMMANDS
  check                  Read-only survey: SO version, install targets, and the
                         configuration settings that decide whether these rules
                         can fire at all. Start here. (default)
  test [pcap]            Load the rules through Suricata via Security Onion's
                         own so-suricata-testrule. With no argument this is a
                         syntax check; given a pcap it also shows which rules
                         fire on that capture. Run before install.
  install                Install the rules into the grid's local rules location.
  remove                 Remove the managed block and the installed Sigma rules.
  deploy                 Apply salt states and restart Suricata / ElastAlert.
  configure              Print the pillar settings these detections depend on.
  verify                 Confirm the rules loaded, and whether they have fired.
  import-pcap <file>     Replay a captured datagram as a positive control.
  export-soc             Emit the rules for the SOC Detections UI. On SO 2.4+
                         this is the only working route - Suricata there loads
                         one SOC-generated file, not local.rules.
                         --format text gives paste-friendly output.
  help                   This text.

OPTIONS
  --confirm              Actually make changes. Without it, every mutating
                         command is a dry run that prints what it would do.
  --rules-path <path>    Override the discovered local.rules location.
  --force                Install even to a path Suricata does not load. Almost
                         always the wrong answer - read 'check' output first.
  -v, --verbose          More detail.

TYPICAL FIRST RUN
  sudo so-udp-delivery check
  sudo so-udp-delivery test
  sudo so-udp-delivery install --confirm
  sudo so-udp-delivery deploy  --confirm
  sudo so-udp-delivery verify

Rules are installed inside a marked block, so reinstalling replaces cleanly
and 'remove' restores the file. Every write is backed up to .backups/ first.
HELPEOF
}

# --- argument parsing ------------------------------------------------------

OPT_RULES_PATH=""
OPT_FORCE=0
OPT_FORMAT="ndjson"
CMD=""
ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --confirm)      CONFIRM=1; shift ;;
        --force)        OPT_FORCE=1; shift ;;
        --format)       OPT_FORMAT="${2:-ndjson}"; shift 2 ;;
        --rules-path)   OPT_RULES_PATH="${2:-}"; shift 2 ;;
        -v|--verbose)   VERBOSE=1; shift ;;
        -h|--help)      cmd_help; exit 0 ;;
        --version)      printf '%s\n' "$VERSION"; exit 0 ;;
        -*)             die "unknown option: $1" ;;
        *)              if [[ -z "$CMD" ]]; then CMD="$1"; else ARGS+=("$1"); fi; shift ;;
    esac
done

[[ $VERBOSE -eq 1 ]] && set -x

case "${CMD:-check}" in
    check)        cmd_check ;;
    test)         cmd_test "${ARGS[@]:-}" ;;
    install)      cmd_install ;;
    remove)       cmd_remove ;;
    deploy)       cmd_deploy ;;
    configure)    cmd_configure ;;
    verify)       cmd_verify ;;
    import-pcap)  cmd_import_pcap "${ARGS[@]:-}" ;;
    export-soc)   cmd_export_soc ;;
    help)         cmd_help ;;
    *)            die "unknown command: $CMD (try: so-udp-delivery help)" ;;
esac
